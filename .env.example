# Names only, never a key: the code signs in with your `az login` (DefaultAzureCredential).
# infra/up.sh writes the real values to .env, which git ignores.
FOUNDRY_RESOURCE=ai103-xxxxxx
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/ai103
FOUNDRY_MODEL_DEPLOYMENT=gpt-5-mini
